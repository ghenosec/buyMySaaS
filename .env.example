# Application
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001

# Database
DATABASE_URL=postgresql://buy_my_saas:change-me@127.0.0.1:5433/buy_my_saas

# Authentication
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_NAME=bms_session

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Optional: only when images are read directly from a public S3-compatible URL.
NEXT_PUBLIC_UPLOADS_URL=

# Storage (use local only in development; use s3 in production)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional: leave empty to serve private-bucket objects through the API.
S3_PUBLIC_URL=

# Security and features
FORCE_HTTPS=false
TRUST_PROXY_HOPS=0
ENABLE_API_DOCS=false
REVIEWS_ENABLED=true
MODERATION_BLOCKED_TERMS=

# Development-only destructive seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin Buy My SaaS

# Platform-provided/build variables (leave Vercel values empty locally)
VERCEL=
RAILPACK_NODE_NPM_INSTALL=npm ci
