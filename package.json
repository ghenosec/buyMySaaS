{
  "name": "buy-my-saas",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=@bms/api\" \"wait-on http://localhost:3001/api/v1/health && npm run dev --workspace=@bms/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@bms/api",
    "test:e2e": "npm run test:e2e --workspace=@bms/web",
    "start:api": "npm run start:prod --workspace=@bms/api",
    "db:generate": "npm run prisma:generate --workspace=@bms/api",
    "db:migrate": "npm run prisma:migrate:dev --workspace=@bms/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@bms/api",
    "db:migrate:status": "npm run prisma:migrate:status --workspace=@bms/api",
    "db:seed": "npm run prisma:seed:dev --workspace=@bms/api",
    "db:studio": "npm run prisma:studio --workspace=@bms/api",
    "security:audit": "npm audit --omit=dev --audit-level=critical",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "next": "^16.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
