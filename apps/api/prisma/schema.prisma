generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SaasStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingType {
  FREE
  FREEMIUM
  SUBSCRIPTION
  ONE_TIME
  LIFETIME
  CUSTOM
}

enum BillingInterval {
  MONTH
  YEAR
  ONE_TIME
}

enum AnalyticsEventType {
  PAGE_VIEW
  WEBSITE_CLICK
  TRIAL_CLICK
  FAVORITE
}

model User {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  googleId        String?            @unique
  avatarUrl       String?
  role            UserRole           @default(USER)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  saas            Saas[]
  reviews         Review[]
  favorites       Favorite[]
  boosts          SaasBoost[]
  auditLogs       AuditLog[]         @relation("AuditActor")
}

model Saas {
  id               String             @id @default(uuid())
  ownerId          String
  name             String
  slug             String             @unique
  tagline          String
  shortDescription String
  description      String
  logoUrl          String?
  accentColor      String?
  countryCode      String             @default("BR")
  language         String             @default("pt-BR")
  websiteUrl       String
  trialUrl         String?
  docsUrl          String?
  demoUrl          String?
  pricingType      PricingType
  priceCents       Int?
  currency         String             @default("BRL")
  billingInterval  BillingInterval?
  pricingLabel     String?
  isBrazilian      Boolean            @default(true)
  isAdult          Boolean            @default(false)
  tags             String[]
  technologies     String[]
  searchVector     Unsupported("tsvector") @default(dbgenerated())
  status           SaasStatus         @default(DRAFT)
  rejectionReason  String?
  launchDate       DateTime?
  publishedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  screenshots      SaasScreenshot[]
  categories       SaasCategory[]
  reviews          Review[]
  favorites        Favorite[]
  boosts           SaasBoost[]
  analyticsEvents  AnalyticsEvent[]

  @@index([status, publishedAt])
  @@index([ownerId, status])
  @@index([priceCents])
}

model SaasScreenshot {
  id       String @id @default(uuid())
  saasId   String
  url      String
  alt      String
  position Int    @default(0)
  saas     Saas   @relation(fields: [saasId], references: [id], onDelete: Cascade)

  @@index([saasId, position])
}

model Category {
  id          String         @id @default(uuid())
  name        String         @unique
  slug        String         @unique
  description String
  icon        String?
  saas        SaasCategory[]
}

model SaasCategory {
  saasId     String
  categoryId String
  saas       Saas     @relation(fields: [saasId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([saasId, categoryId])
}

model Review {
  id               String                 @id @default(uuid())
  userId           String
  saasId           String
  rating           Int
  comment          String
  hidden           Boolean                @default(true)
  spam             Boolean                @default(false)
  spamTerms        String[]               @default([])
  moderationStatus ReviewModerationStatus @default(PENDING)
  moderationReason String?
  moderatedAt      DateTime?
  moderatedById    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  saas             Saas                   @relation(fields: [saasId], references: [id], onDelete: Cascade)

  @@unique([userId, saasId])
  @@index([saasId, createdAt])
  @@index([saasId, spam, createdAt])
  @@index([moderationStatus, createdAt])
}

model Favorite {
  userId    String
  saasId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saas      Saas     @relation(fields: [saasId], references: [id], onDelete: Cascade)

  @@id([userId, saasId])
  @@index([saasId, createdAt])
}

model SaasBoost {
  userId    String
  saasId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saas      Saas     @relation(fields: [saasId], references: [id], onDelete: Cascade)

  @@id([userId, saasId])
  @@index([saasId, createdAt])
}

model AnalyticsEvent {
  id          String             @id @default(uuid())
  saasId      String
  type        AnalyticsEventType
  referrer    String?
  visitorHash String?
  createdAt   DateTime           @default(now())
  saas        Saas               @relation(fields: [saasId], references: [id], onDelete: Cascade)

  @@index([saasId, type, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}
